{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MeetingHear 主窗口权限：对话框（选择音频文件/导出路径）、打开外部链接、核心事件通信",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "opener:allow-open-url"
  ]
}
